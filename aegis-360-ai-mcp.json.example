{
  "mcpServers": {
    "aegis-360-ai": {
      "type": "stdio",
      "command": "/YOUR/INSTALL/PATH/aegis-360-env/bin/python3",
      "args": [
        "/YOUR/INSTALL/PATH/aegis_360_mcp.py",
        "--server",
        "http://127.0.0.1:8888"
      ],
      "description": "Aegis-360 AI v6.0 - Advanced Cybersecurity Automation Platform. Turn off alwaysAllow if you don't want autonomous execution!",
      "timeout": 300,
      "alwaysAllow": []
    }
  }
}
