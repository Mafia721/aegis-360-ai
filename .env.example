# ============================================================================
# Aegis-360 AI v6.0 - Environment Variables Template
# ============================================================================
# Copy this file to .env and fill in your actual API keys
#   cp .env.example .env
#
# NEVER commit your real .env file to version control.
# ============================================================================

# ── Claude (Anthropic) ──────────────────────────────────────────────────────
# Required for AI-powered analysis, exploitation chains, and smart decisions
# Get your key at: https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ── OpenRouter (Qwen3, DeepSeek, GPT-OSS via unified API) ───────────────────
# Used for additional AI model routing and fallbacks
# Get your key at: https://openrouter.ai/
OPENROUTER_API_KEY=YOUR_OPENROUTER_API_KEY
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Legacy aliases — keep in sync with OPENROUTER_API_KEY
QWEN_API_KEY=YOUR_OPENROUTER_API_KEY
QWEN_BASE_URL=https://openrouter.ai/api/v1
QWEN_MODEL=qwen/qwen3-coder:free

# ── Groq (Primary free provider — fast inference) ───────────────────────────
# Required for recon, planning, and communications workflows (free tier available)
# Get your key at: https://console.groq.com/
GROQ_API_KEY=YOUR_GROQ_API_KEY
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Groq model configuration (update if models change)
GROQ_MODEL_LLAMA33=llama-3.3-70b-versatile
GROQ_MODEL_LLAMA4=meta-llama/llama-4-scout-17b-16e-instruct
GROQ_MODEL_QWEN3=qwen/qwen3-32b
GROQ_MODEL_GPTOSS=openai/gpt-oss-120b
GROQ_MODEL_FAST=llama-3.1-8b-instant
GROQ_MODEL=llama-3.3-70b-versatile

# ── Server Configuration ─────────────────────────────────────────────────────
AEGIS_360_PORT=8888
AEGIS_360_HOST=127.0.0.1

# ── Burp Suite Integration (optional) ───────────────────────────────────────
BURP_PROXY=http://127.0.0.1:8080
BURP_PROXY_HOST=127.0.0.1
BURP_PROXY_PORT=8080
BURP_REST_API_PORT=1337
# BURP_API_KEY=YOUR_BURP_REST_API_KEY

# ── Target shortcut ──────────────────────────────────────────────────────────
TARGET_URL=https://example.com

# ============================================================================
# OPTIONAL API KEYS (enhance specific capabilities)
# ============================================================================

# Shodan - Network intelligence and device search
# https://account.shodan.io/
# SHODAN_API_KEY=YOUR_SHODAN_API_KEY

# Censys - Internet-wide scanning data
# https://search.censys.io/account
# CENSYS_API_ID=YOUR_CENSYS_API_ID
# CENSYS_API_SECRET=YOUR_CENSYS_API_SECRET

# Have I Been Pwned - Breach data lookups
# https://haveibeenpwned.com/API/Key
# HAVE_I_BEEN_PWNED_KEY=YOUR_HIBP_API_KEY

# VirusTotal - Malware/URL analysis
# https://www.virustotal.com/gui/my-apikey
# VIRUSTOTAL_API_KEY=YOUR_VIRUSTOTAL_API_KEY

# ============================================================================
# NOTES
# ============================================================================
# - ANTHROPIC_API_KEY and GROQ_API_KEY are the minimum required keys
# - OPENROUTER_API_KEY enables Qwen3 and GPT-OSS model access
# - All OPTIONAL keys are purely additive — the tool works without them
